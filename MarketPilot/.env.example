# --- AI providers -----------------------------------------------------------
# Which providers to try, in order. The first one with working credentials
# answers; if none do, every module falls back to built-in sample content and
# labels it "Demo content" in the UI.
AI_CHAIN=anthropic

# Anthropic. Credentials may also come from ANTHROPIC_AUTH_TOKEN or an
# `ant auth login` profile, so this does not have to be set here.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# OpenAI. BOTH of these are required before the openai provider will be used —
# it reports itself unconfigured and is skipped otherwise. OPENAI_MODEL has no
# default on purpose: model ids change often, and guessing one turns into a
# confusing 404 at request time. Set it to a model your account can call.
OPENAI_API_KEY=
OPENAI_MODEL=
# Only meaningful on reasoning models; leave unset otherwise.
# OPENAI_REASONING_EFFORT=medium

# To prefer OpenAI and keep Anthropic as backup:
#   AI_CHAIN=openai,anthropic
#
# Note: the Marketing Intelligence research stage is Anthropic-only regardless
# of AI_CHAIN — it uses the web_fetch/web_search server tools, which have no
# equivalent on other providers. Without Anthropic credentials that stage is
# skipped and the report is written without live page data.

# --- App --------------------------------------------------------------------
# Signs the session cookie. Required in production; a dev fallback is used otherwise.
AUTH_SECRET=

# Force fixtures even when credentials exist (useful for demos and tests).
MARKETPILOT_MOCK=0

# Where the SQLite file lives. Defaults to ./.data
# MARKETPILOT_DATA_DIR=/absolute/path
